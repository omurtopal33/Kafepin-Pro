+function focusExplorerFolderWindows(folder, callback) {
+  const finishOnce = (() => {
+    let done = false;
+    return (err, detail) => {
+      if (done) return;
+      done = true;
+      callback(err, detail || {});
+    };
+  })();
+
+  // Linux/test ortami icin sadece koruyucu fallback. KafePin saha kurulumu Windows'tur.
+  if (process.platform !== "win32") {
+    try {
+      const child = spawn("xdg-open", [folder], { detached: true, stdio: "ignore" });
+      child.unref();
+      return finishOnce(null, { verified: true, hwnd: 0, method: "xdg-open" });
+    } catch (err) {
+      return finishOnce(err);
+    }
+  }
+
+  // Windows foreground kisiti yuzunden sadece explorer.exe <klasor> komutu gondermek
+  // yeterli degildir. Hedef Explorer penceresinin HWND'si bulunur; pencere restore edilir,
+  // foreground thread ile gecici input baglantisi kurulur ve HWND gercekten foreground
+  // olana kadar kisa araliklarla yeniden denenir. Basari ancak GetForegroundWindow == HWND.
+  const psScript = String.raw`
+$ErrorActionPreference = 'SilentlyContinue'
+$target = [System.IO.Path]::GetFullPath($env:KAFEPIN_FOCUS_FOLDER).TrimEnd('\\')
+Add-Type @'
+using System;
+using System.Runtime.InteropServices;
+public static class KafePinForeground {
+  [DllImport("user32.dll")] public static extern IntPtr GetForegroundWindow();
+  [DllImport("user32.dll")] public static extern bool SetForegroundWindow(IntPtr hWnd);
+  [DllImport("user32.dll")] public static extern bool BringWindowToTop(IntPtr hWnd);
+  [DllImport("user32.dll")] public static extern bool ShowWindowAsync(IntPtr hWnd, int nCmdShow);
+  [DllImport("user32.dll")] public static extern IntPtr SetActiveWindow(IntPtr hWnd);
+  [DllImport("user32.dll")] public static extern IntPtr SetFocus(IntPtr hWnd);
+  [DllImport("user32.dll")] public static extern uint GetWindowThreadProcessId(IntPtr hWnd, out uint processId);
+  [DllImport("kernel32.dll")] public static extern uint GetCurrentThreadId();
+  [DllImport("user32.dll")] public static extern bool AttachThreadInput(uint idAttach, uint idAttachTo, bool fAttach);
+  [DllImport("user32.dll")] public static extern bool SetWindowPos(IntPtr hWnd, IntPtr hWndInsertAfter, int X, int Y, int cx, int cy, uint flags);
+  [DllImport("user32.dll")] public static extern void keybd_event(byte vk, byte scan, uint flags, UIntPtr extraInfo);
+  [DllImport("user32.dll")] public static extern void SwitchToThisWindow(IntPtr hWnd, bool altTab);
+}
+'@
+
+function Normalize-Path([string]$value) {
+  try { return [System.IO.Path]::GetFullPath($value).TrimEnd('\\') } catch { return '' }
+}
+
+function Find-TargetWindow {
+  try {
+    $shell = New-Object -ComObject Shell.Application
+    foreach ($window in @($shell.Windows())) {
+      try {
+        if (-not $window.HWND) { continue }
+        $url = [string]$window.LocationURL
+        if (-not $url.StartsWith('file:', [System.StringComparison]::OrdinalIgnoreCase)) { continue }
+        $candidate = Normalize-Path ([System.Uri]::UnescapeDataString(([System.Uri]$url).LocalPath))
+        if ($candidate -ieq $target) { return $window }
+      } catch {}
+    }
+  } catch {}
+  return $null
+}
+
+function Force-Foreground([IntPtr]$hwnd) {
+  try {
+    [KafePinForeground]::ShowWindowAsync($hwnd, 9) | Out-Null # SW_RESTORE
+    $foreground = [KafePinForeground]::GetForegroundWindow()
+    [uint32]$pidA = 0
+    [uint32]$pidB = 0
+    $foregroundThread = if ($foreground -ne [IntPtr]::Zero) { [KafePinForeground]::GetWindowThreadProcessId($foreground, [ref]$pidA) } else { 0 }
+    $targetThread = [KafePinForeground]::GetWindowThreadProcessId($hwnd, [ref]$pidB)
+    $currentThread = [KafePinForeground]::GetCurrentThreadId()
+    $attachedForeground = $false
+    $attachedTarget = $false
+    try {
+      if ($foregroundThread -gt 0 -and $foregroundThread -ne $currentThread) {
+        $attachedForeground = [KafePinForeground]::AttachThreadInput($currentThread, $foregroundThread, $true)
+      }
+      if ($targetThread -gt 0 -and $targetThread -ne $currentThread) {
+        $attachedTarget = [KafePinForeground]::AttachThreadInput($currentThread, $targetThread, $true)
+      }
+      # Windows'un foreground-lock davranisini kullanici ALT girdisiyle serbest birak.
+      [KafePinForeground]::keybd_event(0x12, 0, 0, [UIntPtr]::Zero)
+      [KafePinForeground]::keybd_event(0x12, 0, 2, [UIntPtr]::Zero)
+      [KafePinForeground]::SwitchToThisWindow($hwnd, $true)
+      # Kisa TOPMOST -> NOTOPMOST dansi pencereyi Z-order'in basina tasir ama kalici topmost birakmaz.
+      $flags = 0x0001 -bor 0x0002 -bor 0x0040
+      [KafePinForeground]::SetWindowPos($hwnd, [IntPtr](-1), 0, 0, 0, 0, $flags) | Out-Null
+      [KafePinForeground]::SetWindowPos($hwnd, [IntPtr](-2), 0, 0, 0, 0, $flags) | Out-Null
+      [KafePinForeground]::BringWindowToTop($hwnd) | Out-Null
+      [KafePinForeground]::SetActiveWindow($hwnd) | Out-Null
+      [KafePinForeground]::SetForegroundWindow($hwnd) | Out-Null
+      [KafePinForeground]::SetFocus($hwnd) | Out-Null
+    } finally {
+      if ($attachedTarget) { [KafePinForeground]::AttachThreadInput($currentThread, $targetThread, $false) | Out-Null }
+      if ($attachedForeground) { [KafePinForeground]::AttachThreadInput($currentThread, $foregroundThread, $false) | Out-Null }
+    }
+  } catch {}
+}
+
+$window = Find-TargetWindow
+if (-not $window) {
+  try { Start-Process -FilePath (Join-Path $env:WINDIR 'explorer.exe') -ArgumentList @($target) | Out-Null } catch {}
+}
+
+$deadline = (Get-Date).AddSeconds(4.5)
+do {
+  $window = Find-TargetWindow
+  if ($window) {
+    try {
+      $hwnd = [IntPtr]([Int64]$window.HWND)
+      Force-Foreground $hwnd
+      Start-Sleep -Milliseconds 120
+      if ([KafePinForeground]::GetForegroundWindow() -eq $hwnd) {
+        Write-Output ('FOCUSED|' + [string]$window.HWND)
+        exit 0
+      }
+    } catch {}
+  }
+  Start-Sleep -Milliseconds 140
+} while ((Get-Date) -lt $deadline)
+
+# Ilk acilis Explorer tarafinda gec kaldiysa bir kez daha shell'i tetikle ve zorla.
+try { Start-Process -FilePath (Join-Path $env:WINDIR 'explorer.exe') -ArgumentList @($target) | Out-Null } catch {}
+$retryDeadline = (Get-Date).AddSeconds(2.0)
+do {
+  $window = Find-TargetWindow
+  if ($window) {
+    try {
+      $hwnd = [IntPtr]([Int64]$window.HWND)
+      Force-Foreground $hwnd
+      Start-Sleep -Milliseconds 120
+      if ([KafePinForeground]::GetForegroundWindow() -eq $hwnd) {
+        Write-Output ('FOCUSED|' + [string]$window.HWND)
+        exit 0
+      }
+    } catch {}
+  }
+  Start-Sleep -Milliseconds 140
+} while ((Get-Date) -lt $retryDeadline)
+
+Write-Output 'NOT_FOCUSED'
+exit 3
+`;
+
+  const encoded = Buffer.from(psScript, "utf16le").toString("base64");
+  let stdout = "";
+  let stderr = "";
+  let child;
+  try {
+    child = spawn("powershell.exe", [
+      "-NoProfile",
+      "-NonInteractive",
+      "-STA",
+      "-ExecutionPolicy", "Bypass",
+      "-EncodedCommand", encoded
+    ], {
+      windowsHide: true,
+      env: { ...process.env, KAFEPIN_FOCUS_FOLDER: folder },
+      stdio: ["ignore", "pipe", "pipe"]
+    });
+  } catch (err) {
+    return finishOnce(err);
+  }
+
+  const timer = setTimeout(() => {
+    try { child.kill(); } catch (_err) {}
+    finishOnce(new Error("Explorer penceresi öne getirilemedi (odak zaman aşımı)"));
+  }, 8000);
+  if (child.stdout) child.stdout.on("data", chunk => { stdout += String(chunk || ""); });
+  if (child.stderr) child.stderr.on("data", chunk => { stderr += String(chunk || ""); });
+  child.on("error", err => {
+    clearTimeout(timer);
+    finishOnce(err);
+  });
+  child.on("close", code => {
+    clearTimeout(timer);
+    const match = stdout.match(/FOCUSED\|(\d+)/i);
+    if (Number(code) === 0 && match) {
+      return finishOnce(null, { verified: true, hwnd: Number(match[1]) || 0, method: "hwnd-foreground" });
+    }
+    finishOnce(new Error((stderr || stdout || "Explorer penceresi öne getirilemedi").trim()));
+  });
+}
