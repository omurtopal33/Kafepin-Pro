+function fetchTextWithWindowsFallback(url) {
+  const cleanUrl = String(url || "").trim();
+  if (!/^https:\/\//i.test(cleanUrl)) throw new Error("Guncelleme adresi gecersiz");
+
+  // Node HTTPS bazı Windows kurulumlarında sertifika/TLS zinciri nedeniyle
+  // GitHub'a ulaşamazsa Windows ağ katmanı ikinci yol olarak devreye girer.
+  const curlExe = process.platform === "win32"
+    ? path.join(process.env.SystemRoot || "C:\\Windows", "System32", "curl.exe")
+    : "curl";
+  try {
+    const curl = spawnSync(curlExe, [
+      "-L", "--fail", "--silent", "--show-error",
+      "--connect-timeout", "5", "--max-time", "15",
+      "-A", "KafePin-Pro-Updater",
+      "-H", "Cache-Control: no-cache", cleanUrl
+    ], { encoding: "utf8", windowsHide: true, timeout: 18000, maxBuffer: 2 * 1024 * 1024 });
+    if (!curl.error && curl.status === 0 && String(curl.stdout || "").trim()) return String(curl.stdout);
+  } catch (_err) {}
+
+  if (process.platform === "win32") {
+    try {
+      const ps = spawnSync("powershell.exe", [
+        "-NoProfile", "-ExecutionPolicy", "Bypass", "-Command",
+        "$ErrorActionPreference='Stop';$ProgressPreference='SilentlyContinue';" +
+        "[Net.ServicePointManager]::SecurityProtocol=[Net.SecurityProtocolType]::Tls12;" +
+        "$r=Invoke-WebRequest -UseBasicParsing -Headers @{'User-Agent'='KafePin-Pro-Updater';'Cache-Control'='no-cache'} -Uri $env:KAFEPIN_FETCH_URL -TimeoutSec 15;" +
+        "[Console]::OutputEncoding=[Text.Encoding]::UTF8;[Console]::Write($r.Content)"
+      ], {
+        encoding: "utf8", windowsHide: true, timeout: 20000, maxBuffer: 2 * 1024 * 1024,
+        env: { ...process.env, KAFEPIN_FETCH_URL: cleanUrl }
+      });
+      if (!ps.error && ps.status === 0 && String(ps.stdout || "").trim()) return String(ps.stdout);
+    } catch (_err) {}
+  }
+  throw new Error("Windows ag yedek yolu da guncelleme merkezine ulasamadi");
+}
+
+function decodeGitHubContentsManifest(body) {
+  try {
+    const data = JSON.parse(String(body || ""));
+    if (!data || String(data.encoding || "").toLowerCase() !== "base64" || !data.content) return "";
+    return Buffer.from(String(data.content).replace(/\s+/g, ""), "base64").toString("utf8");
+  } catch (_err) { return ""; }
+}
