+function downloadUpdateFile(url, destination, callback) {
+  let completed = false;
+  const done = err => { if (completed) return; completed = true; callback(err || null); };
+  downloadUpdateFileNode(url, destination, nodeErr => {
+    if (!nodeErr) return done(null);
+    try {
+      downloadUpdateFileWindowsFallback(url, destination);
+      addLiveLog("pro_update", "ℹ️ Paket indirme Windows yedek ag yolu ile tamamlandi");
+      return done(null);
+    } catch (fallbackErr) {
+      const a = String(nodeErr && nodeErr.message || nodeErr || "Node HTTPS hatasi");
+      const b = String(fallbackErr && fallbackErr.message || fallbackErr || "Windows ag hatasi");
+      return done(new Error(`${a} | ${b}`));
+    }
+  });
+}
