        raise SystemExit('v4.0.2 sha file invalid')
    return m.group(1).lower()


def replace_once(text: str, old: str, new: str, label: str) -> str:
    n = text.count(old)
    if n != 1:
        raise SystemExit(f'{label}: expected one occurrence, found {n}')
    return text.replace(old, new, 1)


def read_yazici_version(root: Path) -> str:
    source = root / 'dev' / 'v403-edevlet-candidate' / 'yazici-version.json'
    try:
        value = str(json.loads(source.read_text(encoding='utf-8')).get('version') or '').strip()
    except Exception as exc:
        raise SystemExit(f'Yazici version source invalid: {source}: {exc}')
    if not re.fullmatch(r'\d+\.\d+\.\d+(?:[-+][0-9A-Za-z.-]+)?', value):
        raise SystemExit(f'Yazici version source invalid value: {value!r}')
    return value


def patch_revenue(text: str, target_version: str) -> str:
    dynamic = '''const VERSION = (() => {
  try { return String(JSON.parse(fs.readFileSync(path.join(__dirname, "yazici-pro-version.json"), "utf8")).version || "unknown"); }
  catch (_) { return "unknown"; }
})();'''
    text, count = re.subn(r'const VERSION = "[^"]+";', dynamic, text, count=1)
    if count != 1:
        raise SystemExit('Yazici revenue VERSION assignment missing')
    text = replace_once(text, '  price_document:30,\n  payment_method:"CASH",', '  price_document:30,\n  price_edevlet:0,\n  payment_method:"CASH",', 'e-Devlet saved price default')
    text = replace_once(text, '["price_bw","price_color","price_identity","price_photo","price_scan","price_document"]', '["price_bw","price_color","price_identity","price_photo","price_scan","price_document","price_edevlet"]', 'e-Devlet saved price validation')
    text = replace_once(text, '["price_bw","price_color","price_identity","price_photo","price_scan","price_document","payment_method","delete_download_after_print"]', '["price_bw","price_color","price_identity","price_photo","price_scan","price_document","price_edevlet","payment_method","delete_download_after_print"]', 'e-Devlet saved price config route')
    old = '''function prepareService(serviceType,quantity,payment,documentPrep=false,title=""){
  const c=config(); const qty=Math.max(1,Math.min(999,Number(quantity)||1)); const items=[]; let serviceLabel="Tarama";
  if(serviceType==="scan"){ items.push({label:"Tarama",unitPrice:Number(c.price_scan)||0,quantity:qty}); serviceLabel="Tarama"; }
  else if(serviceType==="document"){ items.push({label:"Belge / Dilekçe Hazırlama",unitPrice:Number(c.price_document)||0,quantity:1}); serviceLabel="Belge / Dilekçe Hazırlama"; }
  else throw new Error("Geçersiz hizmet türü.");
  if(documentPrep && serviceType!=="document") items.push({label:"Belge / Dilekçe Hazırlama",unitPrice:Number(c.price_document)||0,quantity:1});
  return createTransaction({source:"service",title:title||`Yazıcı Geliri - ${serviceLabel}${documentPrep&&serviceType!=="document"?" + Belge Hazırlama":""}`,items,payment,meta:{service_type:serviceType,quantity:qty,document_prep:!!documentPrep}});
}'''
    new = '''function prepareService(serviceType,quantity,payment,documentPrep=false,title="",amountOverride=null){
  const c=config(); const qty=Math.max(1,Math.min(999,Number(quantity)||1)); const items=[]; let serviceLabel="Tarama";
  if(serviceType==="scan"){ items.push({label:"Tarama",unitPrice:Number(c.price_scan)||0,quantity:qty}); serviceLabel="Tarama"; }
  else if(serviceType==="document"){ items.push({label:"Belge / Dilekçe Hazırlama",unitPrice:Number(c.price_document)||0,quantity:1}); serviceLabel="Belge / Dilekçe Hazırlama"; }
  else if(serviceType==="edevlet"){ const amount=money(amountOverride===null||amountOverride===undefined?c.price_edevlet:amountOverride); if(amount<=0) throw new Error("e-Devlet hizmet bedeli 0 TL olamaz."); items.push({label:"e-Devlet Hizmet Bedeli",unitPrice:amount,quantity:1}); serviceLabel="e-Devlet Hizmet Bedeli"; }
  else throw new Error("Geçersiz hizmet türü.");
  if(documentPrep && serviceType!=="document" && serviceType!=="edevlet") items.push({label:"Belge / Dilekçe Hazırlama",unitPrice:Number(c.price_document)||0,quantity:1});
  return createTransaction({source:"service",title:title||`Yazıcı Geliri - ${serviceLabel}${documentPrep&&serviceType!=="document"&&serviceType!=="edevlet"?" + Belge Hazırlama":""}`,items,payment,meta:{service_type:serviceType,quantity:qty,document_prep:!!documentPrep}});
}'''
    text = replace_once(text, old, new, 'prepareService')
    old_route = 'if(req.method==="POST"&&p==="/service/prepare"){ const d=await readBody(req); const tx=prepareService(String(d.service_type||"scan"),Number(d.quantity)||1,String(d.payment_method||"CASH"),!!d.document_prep,String(d.title||"")); return json(res,200,{ok:true,transaction:tx}); }'
    new_route = 'if(req.method==="POST"&&p==="/service/prepare"){ const d=await readBody(req); const tx=prepareService(String(d.service_type||"scan"),Number(d.quantity)||1,String(d.payment_method||"CASH"),!!d.document_prep,String(d.title||""),Object.prototype.hasOwnProperty.call(d,"amount")?d.amount:null); return json(res,200,{ok:true,transaction:tx}); }'
    return replace_once(text, old_route, new_route, 'service route')


def patch_service_host(text: str, target_version: str) -> str:
    dynamic = "$VersionFile=Join-Path $InstallRoot 'yazici-pro-version.json'\n$Expected=''\ntry { $Expected=[string]((Get-Content -LiteralPath $VersionFile -Raw -Encoding UTF8 | ConvertFrom-Json).version).Trim() } catch {}\nif([string]::IsNullOrWhiteSpace($Expected)){ throw ('Yazici PRO metadata version okunamadi: '+$VersionFile) }"
    text, count = re.subn(r"\$Expected='[^']+'", dynamic, text, count=1)
    if count != 1:
        raise SystemExit('Yazici service host expected-version assignment missing')
    text = re.sub(r'v\d+-yazici-startup\.log', 'yazici-startup.log', text)
    text = re.sub(r'v\d+-yazici-startup\.json', 'yazici-startup.json', text)
    text = re.sub(r'v\d+-revenue\.(out|err)\.log', r'yazici-revenue.\1.log', text)
    text = re.sub(r'v\d+-webservice\.(out|err)\.log', r'yazici-webservice.\1.log', text)
    text = re.sub(r'\[v\d+\]', '[yazici]', text)
    text = re.sub(r'Servisler zaten [^\r\n]+ hazır\.', 'Servisler metadata sürümünde hazır.', text)
    return text


def patch_payload(tmp: Path, target_version: str) -> None:
    p = tmp / 'KafePin_YaziciPRO_WebView2.ps1'
    p.write_text('\ufeff' + WEBVIEW_PS1.replace('\r\n','\n').replace('__KAFEPIN_YAZICI_VERSION__', target_version), encoding='utf-8')

    p = tmp / 'KafePin_YaziciGelir_Service.js'
    p.write_text(patch_revenue(p.read_text(encoding='utf-8-sig'), target_version), encoding='utf-8')

    p = tmp / 'KafePin_YaziciPRO_ServiceHost.ps1'
    host = patch_service_host(p.read_text(encoding='utf-8-sig'), target_version)
    p.write_text('\ufeff' + host, encoding='utf-8')

    p = tmp / 'web_service.py'
    s = p.read_text(encoding='utf-8-sig')
    dynamic = '''VERSION_FILE = Path(__file__).resolve().with_name("yazici-pro-version.json")
try:
    APP_VERSION = str(json.loads(VERSION_FILE.read_text(encoding="utf-8-sig")).get("version") or "unknown").strip()
except Exception:
    APP_VERSION = "unknown"'''
    s, count = re.subn(r'APP_VERSION = "[^"]+"', dynamic, s, count=1)
    if count != 1:
        raise SystemExit('Yazici web service APP_VERSION assignment missing')
    p.write_text(s, encoding='utf-8')

    p = tmp / 'yazici-pro-version.json'
    meta = json.loads(p.read_text(encoding='utf-8-sig'))
    meta['version'] = target_version
    meta['build'] = 'v403-edevlet-candidate1'
    fixes = list(meta.get('fixes') or [])
    for item in [
        'edevlet-internal-webview2-tab',
        'edevlet-no-external-window',
        'edevlet-separate-private-profile',
        'edevlet-session-cookie-clear',
        'edevlet-single-service-fee-per-session',
        'edevlet-print-fees-remain-printservice-based',
    ]:
        if item not in fixes:
            fixes.append(item)
    meta['fixes'] = fixes
    p.write_text(json.dumps(meta, ensure_ascii=False, indent=2) + '\n', encoding='utf-8')


def repack_nested(original_bytes: bytes, modified_root: Path) -> bytes:
    src = zipfile.ZipFile(io.BytesIO(original_bytes), 'r')
    out = io.BytesIO()
    with zipfile.ZipFile(out, 'w') as z:
        for info in src.infolist():
            data = src.read(info.filename)
            if not info.is_dir() and info.filename in ALLOWED_YAZICI:
                data = (modified_root / Path(info.filename)).read_bytes()
            z.writestr(info, data)
    return out.getvalue()


def main() -> None:
    root = Path(os.environ.get('GITHUB_WORKSPACE') or Path.cwd())
    base = root / BASE_NAME
    if not base.exists():
        raise SystemExit(f'base missing: {base}')
    expected = read_expected_sha(root)
    base_bytes = base.read_bytes()
    base_sha = sha(base_bytes)
    if base_sha != expected:
        raise SystemExit(f'v4.0.2 base sha mismatch expected={expected} actual={base_sha}')

    with zipfile.ZipFile(io.BytesIO(base_bytes), 'r') as outer:
        names = outer.namelist()
        if 'update.json' not in names or NESTED not in names:
            raise SystemExit('base package missing update.json or yazici-pro.zip')
        base_update = json.loads(outer.read('update.json').decode('utf-8-sig'))
        if str(base_update.get('version')) != '4.0.2' or str(base_update.get('channel')) != 'stable':
            raise SystemExit('base package is not v4.0.2 stable')
        nested_bytes = outer.read(NESTED)

